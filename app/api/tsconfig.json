{
  // Vercel compiles each function on its own: rewrite "./x.ts" imports to "./x.js" in the output.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": ["./**/*.ts", "../src/lib/**/*.ts", "../src/config/**/*.ts"]
}
